# === 7. User Specific & Security (Recommended) ===
.local/             # 사용자 로컬 라이브러리 및 바이너리 (매우 중요)
.gitconfig          # 개인 Git 설정 파일
.gnupg/             # GPG 보안 키 관련 폴더
.bash_history       # 터미널 명령어 기록
.bashrc             # 개인 쉘 설정
.profile            # 시스템 프로필

